# Copy this file to .env and fill in the keys you have (setup does the copy).
# Put your keys only in .env, never in this file: .env stays on your laptop
# and is never uploaded to GitHub.
# Every provider here has a free tier. Leave a key empty to skip that provider.
# Jarvis tries them in the order set in config/settings.toml -> [llm] order.
# One key is enough to start; Gemini + Groq is the recommended pair.

# Google AI Studio: https://aistudio.google.com/apikey
# Free tier: prompts may be used to improve Google's products and can be read by
# human reviewers. Don't send passwords or private documents through it.
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
# One Groq key gives Jarvis two brains: OpenAI's gpt-oss-20b (fast) and gpt-oss-120b.
GROQ_API_KEY=

# OpenRouter (only models ending in ":free" cost nothing): https://openrouter.ai/keys
# Optional: an extra backup.
OPENROUTER_API_KEY=

# Ollama runs locally and needs no key: https://ollama.com

# YouTube by voice reads video titles with the YouTube Data API (free, about
# 100 searches a day): Google Cloud Console -> new project -> enable "YouTube
# Data API v3" -> Credentials -> API key. Optional: without it Jarvis just
# opens the YouTube results page.
YOUTUBE_API_KEY=

# --- Later, when these skills are built (not needed yet) ---------------------
# Research skill, web search (1,000 free searches a month): https://tavily.com
# TAVILY_API_KEY=
# Research skill, papers (works without a key; a free key allows ~1,000
# searches a day): https://openalex.org/settings/api
# OPENALEX_API_KEY=
# Telegram channel, only if you switch it on: create a bot with @BotFather
# TELEGRAM_BOT_TOKEN=
